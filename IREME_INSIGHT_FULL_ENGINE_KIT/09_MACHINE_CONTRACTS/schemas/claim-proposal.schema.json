{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ireme.example/spec/claim-proposal",
  "title": "Claim Proposal",
  "description": "AI output is typed references; no free-form numeric text field is accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "claim_type",
    "fact_ids",
    "relation",
    "qualification_code",
    "evidence_ids",
    "section"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "descriptive",
        "comparison",
        "trend",
        "association",
        "causal_effect",
        "uncertainty",
        "limitation"
      ]
    },
    "fact_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relation": {
      "type": "string",
      "enum": [
        "above",
        "below",
        "approximately_equal",
        "increased",
        "decreased",
        "association",
        "unknown",
        "not_applicable"
      ]
    },
    "qualification_code": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "section": {
      "type": "string",
      "minLength": 1
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
