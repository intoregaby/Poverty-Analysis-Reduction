flowchart TB
  NEED["Verified district need and uncertainty"] --> HYPO["Competing explanations and evidence gaps"]
  HYPO --> RESEARCH["Intervention evidence registry"]
  RESEARCH --> TRANS["Rwanda applicability and feasibility review"]
  TRANS --> EQUITY["Equity, potential harms and cost assumptions"]
  EQUITY --> CLASS["Action class: study, audit, pilot, consider scale, avoid"]
  CLASS --> PLAN["Owner, milestones, budget evidence and approvals"]
  PLAN --> MON["Outcome/implementation measurement"]
  MON --> EVAL["Registered evaluation design and uncertainty"]
  EVAL --> NEW["New versioned investigation and policy review"]
